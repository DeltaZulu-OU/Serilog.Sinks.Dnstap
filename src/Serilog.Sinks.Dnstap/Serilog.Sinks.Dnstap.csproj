<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Serilog.Sinks.Dnstap</PackageId>
    <Version>0.1.0</Version>
    <Authors>DeltaZulu OÜ</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DeltaZulu-OU/Serilog.Sinks.Dnstap</RepositoryUrl>
    <Description>Serilog sink for DNS telemetry encoded using the DNSTap protocol.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Dnstap.NET" Version="0.1.0" />
  </ItemGroup>
</Project>
