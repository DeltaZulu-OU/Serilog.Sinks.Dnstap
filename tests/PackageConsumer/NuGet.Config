<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-release-candidate" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="deltazulu-github" value="https://nuget.pkg.github.com/DeltaZulu-OU/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-release-candidate">
      <package pattern="Serilog.Sinks.Dnstap" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="deltazulu-github">
      <package pattern="Dnstap.NET" />
    </packageSource>
  </packageSourceMapping>
</configuration>
